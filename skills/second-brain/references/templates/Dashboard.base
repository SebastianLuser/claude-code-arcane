filters:
  and:
    - '!file.inFolder("Templates")'
    - '!file.inFolder("04_Archive")'

formulas:
  days_untouched: '(now() - file.mtime).days'

properties:
  status:
    displayName: Maturity
  formula.days_untouched:
    displayName: "Days untouched"
  file.mtime:
    displayName: Modified

views:
  - type: table
    name: "Seeds that did not grow"
    filters:
      and:
        - 'status == "seed"'
        - "formula.days_untouched > 30"
    order:
      - file.name
      - formula.days_untouched
      - created
    summaries:
      formula.days_untouched: Average

  - type: table
    name: "Open contradictions"
    filters:
      - 'status == "contested"'
    order:
      - file.name
      - created

  - type: table
    name: "Touched this week"
    limit: 30
    filters:
      - "file.mtime > now() - 7d"
    order:
      - file.mtime
      - file.name
      - status

  - type: table
    name: "Knowledge by maturity"
    filters:
      - 'type == "atomic" || type == "hub" || type == "clip"'
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - formula.days_untouched

  - type: table
    name: "Active projects"
    filters:
      and:
        - 'type == "project"'
        - 'status != "closed"'
    order:
      - file.name
      - status
      - deadline

  "structures": [
    {
      "id": "no-solo",
      "regex": "(?i)\\bno (?:es|se trata de) (?:solo|sólo|solamente|simplemente) [^.!?\\n]{2,60}[,.;] (?:es|se trata de)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Say the one thing you mean. Delete the setup half."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
      "name": "\"No solo X sino también Y\"",
      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.!] se trata de\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Lead with Y. The reversal is the tell."
    },
    {
      "id": "the-result",
      "regex": "(?im)^\\s*¿(?:el resultado|lo mejor|la clave|el truco|la trampa)\\?\\s*$",
      "name": "One-word rhetorical question line",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\besto es lo que aprend(?:í|imos)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
      "name": "Rule-of-three triad",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags. LinkedIn stopped rewarding the wall."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "in-summary",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en definitiva)\\b",
      "name": "Essay-closer opener",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)¿(?:estás de acuerdo|qué opinan|qué opinás|qué piensan|quién más|me equivoco)\\??\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    }
  ],
  "examples": {
    "rewrite": [
      {
        "text": "En el mundo actual, es importante destacar que la IA es fundamental. Construimos una solución robusta\u200b para el equipo. ¿Qué opinan?",
        "clean": "Hoy, la IA es fundamental. Construimos una solución sólida para el equipo. ¿Qué opinan?",
        "flags": [
          "Reflex engagement bait",
          "fundamental"
        ]
      }
    ],
    "keep": [
      "Mañana lanzamos la versión nueva. Si algo falla, avisame y lo arreglo antes del viernes."
    ],
    "pronouns": {
